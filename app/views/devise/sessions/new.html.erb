<h2>ログイン画面</h2>

<%= form_with model: @user, url: user_session_path, data: { turbo: false } do |f| %>
  <div class="field">
    <%= f.label :email, "メールアドレス" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :password, "パスワード" %><br />
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "ログイン状態を保持" %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "ログイン" %>
  </div>
<% end %>

<%= link_to "サインアップ", new_user_registration_path %><br />
<%= link_to "パスワードをお忘れですか?", new_user_password_path %><br />
<%= link_to "トップ画面に戻る", root_path %>